FROM debezium/connect:2.4

USER root

# Instalar dependências (curl, unzip) suportando diferentes gerenciadores de pacote
RUN if command -v microdnf >/dev/null; then microdnf install -y curl unzip; \
    elif command -v apt-get >/dev/null; then apt-get update && apt-get install -y curl unzip; \
    else yum install -y curl unzip; fi

# Baixar e instalar o conector oficial do Neo4j Kafka Sink via GitHub (v5.3.0)
RUN curl -L -o /tmp/neo4j-connector.zip https://github.com/neo4j/neo4j-kafka-connector/releases/download/5.3.0/neo4j-kafka-connect-5.3.0.zip && \
    unzip /tmp/neo4j-connector.zip -d /kafka/connect/neo4j-sink && \
    rm /tmp/neo4j-connector.zip

USER kafka
