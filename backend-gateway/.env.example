# Database connection
# Use localhost:5432 when running migrations from the host machine
# Use postgres:5432 when running inside the Docker network
DATABASE_URL="postgresql://admin:CHANGE_ME@localhost:5432/medical_ehr?schema=public"

# App
PORT=3000
NODE_ENV=development

# Diagnostic Engine (gRPC)
DIAGNOSTIC_ENGINE_URL=localhost:50051

# JWT Authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# CORS
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3001,http://localhost:8081
